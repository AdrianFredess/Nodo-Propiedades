{
  "name": "PANEL-04 Realtime Emit",
  "nodes": [
    {
      "id": "panel04-webhook",
      "name": "Webhook Realtime Emit",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        200,
        300
      ],
      "webhookId": "panel-realtime-emit",
      "parameters": {
        "httpMethod": "POST",
        "path": "panel-realtime-emit",
        "responseMode": "responseNode",
        "options": { "allowedOrigins": "http://localhost:5173" }
      }
    },
    {
      "id": "panel04-prep",
      "name": "Normalizar Evento",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "jsCode": "const root = $input.first().json;\nconst body = root.body && typeof root.body === 'object' ? root.body : root;\nconst type = String(body.type || body.event || 'leads.refresh').trim();\nconst payload =\n  body.payload !== undefined\n    ? body.payload\n    : (() => {\n        const { type: _t, event: _e, payload: _p, ...rest } = body;\n        return rest;\n      })();\nreturn [{ json: { type, payload, at: new Date().toISOString() } }];"
      }
    },
    {
      "id": "panel04-http",
      "name": "Forward WS Bridge",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        300
      ],
      "onError": "continueRegularOutput",
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:3099/emit",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ type: $json.type, payload: $json.payload }) }}",
        "options": {
          "timeout": 3000,
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      }
    },
    {
      "id": "panel04-ok",
      "name": "Responder OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        920,
        300
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: true, type: $('Normalizar Evento').first().json.type, bridge: $json }) }}",
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "Access-Control-Allow-Origin",
                "value": "={{ $env.PANEL_ORIGIN || 'http://localhost:5173' }}"
              }
            ]
          }
        }
      }
    },
    {
      "id": "panel-auth-check",
      "name": "Check Panel Auth",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        280,
        300
      ],
      "parameters": {
        "jsCode": "const crypto = require('crypto');\r\n\r\nconst item = $input.first().json || {};\r\nconst headers = item.headers || {};\r\nconst norm = {};\r\nfor (const [k, v] of Object.entries(headers)) norm[String(k).toLowerCase()] = v;\r\nconst authHeader = String(norm.authorization || '');\r\nconst bearer = authHeader.toLowerCase().startsWith('bearer ') ? authHeader.slice(7).trim() : '';\r\nconst got = String(norm['x-panel-token'] || bearer || '').trim();\r\nlet expected = '';\r\ntry {\r\n  expected = String(($env && $env.PANEL_API_TOKEN) || '').trim();\r\n} catch (e) {\r\n  expected = '';\r\n}\r\nlet authOk = false;\r\nif (expected && got) {\r\n  const a = Buffer.from(expected);\r\n  const b = Buffer.from(got);\r\n  authOk = a.length === b.length && crypto.timingSafeEqual(a, b);\r\n}\r\nreturn [{ json: { ...item, _authOk: authOk } }];\r\n"
      }
    },
    {
      "id": "panel-auth-if",
      "name": "IF Panel Auth OK",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        500,
        300
      ],
      "parameters": {
        "conditions": {
          "combinator": "and",
          "options": {
            "version": 2,
            "typeValidation": "strict",
            "caseSensitive": true,
            "leftValue": ""
          },
          "conditions": [
            {
              "id": "auth-ok",
              "leftValue": "={{ $json._authOk }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "panel-auth-fail",
      "name": "Responder Auth Fail",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        500,
        480
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: false, error: 'unauthorized' }) }}",
        "options": {
          "responseCode": 401
        }
      }
    }
  ],
  "connections": {
    "Webhook Realtime Emit": {
      "main": [
        [
          {
            "node": "Check Panel Auth",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalizar Evento": {
      "main": [
        [
          {
            "node": "Forward WS Bridge",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Forward WS Bridge": {
      "main": [
        [
          {
            "node": "Responder OK",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Panel Auth": {
      "main": [
        [
          {
            "node": "IF Panel Auth OK",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "IF Panel Auth OK": {
      "main": [
        [
          {
            "node": "Normalizar Evento",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Responder Auth Fail",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
