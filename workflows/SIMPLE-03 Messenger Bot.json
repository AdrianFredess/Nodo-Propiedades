    {
      "id": "s03-node-09",
      "name": "Code - Armar Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1740,
        300
      ],
      "parameters": {
        "jsCode": "const prep = $('Code - Normalizar Messenger').item.json;\nconst prompt = `Sos un asistente de una inmobiliaria llamada Nodo Propiedades.\nEl cliente ${prep.lead_name} te escribió por Messenger: \"${prep.mensaje}\"\n\nTu tarea:\n1. Analizar su intención (comprar, alquilar, consulta, sin interés)\n2. Clasificar su temperatura: frio (solo curiosidad), tibio (interés real), caliente (listo para avanzar)\n3. Generar una respuesta breve y amigable en español\n\nResponde SOLO con este JSON sin texto adicional:\n{\"temperatura\":\"frio|tibio|caliente\",\"intencion\":\"descripcion breve\",\"respuesta\":\"mensaje para el cliente\"}`;\n\nreturn [{\n  json: {\n    ...prep,\n    prompt_groq: prompt\n  }\n}];"
      }
    },
    {
      "id": "s03-node-10",
      "name": "Basic LLM Chain",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.4,
      "position": [
        1960,
        300
      ],
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.prompt_groq }}"
      }
    },
    {
      "id": "s03-node-11",
      "name": "Groq Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1,
      "position": [
        1960,
        520
      ],
      "parameters": {
        "model": "openai/gpt-oss-120b",
        "options": {
          "baseURL": "https://api.groq.com/openai/v1"
        }
      },
      "credentials": {
        "openAiApi": {
          "id": "GgWE6f3vqREslMLv",
          "name": "Groq API"
        }
      }
    },
    {
      "id": "s03-node-12",
      "name": "Code - Procesar IA",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2180,
        300
      ],
      "parameters": {
        "jsCode": "const textoIA = ($json.text || '').trim();\nconst prep = $('Code - Normalizar Messenger').item.json;\n\nlet temperatura = 'frio';\nlet intencion = 'consulta general';\nlet respuesta = '¡Hola! Gracias por contactarnos. ¿En qué te puedo ayudar?';\n\ntry {\n  const match = textoIA.match(/\\{[\\s\\S]*?\\}/);\n  if (match) {\n    const parsed = JSON.parse(match[0]);\n    temperatura = parsed.temperatura || 'frio';\n    intencion = parsed.intencion || 'consulta general';\n    respuesta = parsed.respuesta || respuesta;\n  }\n} catch(e) {}\n\nreturn [{\n  json: {\n    ...prep,\n    temperatura,\n    intencion,\n    respuesta_messenger: respuesta\n  }\n}];"
      }
    },
