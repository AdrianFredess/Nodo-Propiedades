      "name": "Google Sheets - Read",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        260,
        300
      ],
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "__SET_GOOGLE_SHEET_ID__"
        },
        "sheetName": {
