    },
    {
      "id": "s04-n08",
      "name": "Meta Enviar WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        2480,
        480
      ],
      "parameters": {
        "method": "POST",
        "url": "https://graph.facebook.com/__SET_META_GRAPH_VERSION__/__SET_META_PHONE_NUMBER_ID__/messages",
        "sendBody": true,
        "specifyBody": "json",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer __SET_META_ACCESS_TOKEN__"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "jsonBody": "={{ JSON.stringify({ messaging_product: \"whatsapp\", recipient_type: \"individual\", to: (function(p){p=String(p||\"\").replace(/\\D/g,\"\");if(/^549\\d{8,11}$/.test(p))return \"54\"+p.slice(3);return p;})($json.telefono || $json.phone || $json.chat_id || \"\"), type: \"text\", text: { preview_url: false, body: String($json.mensaje || \"\") } }) }}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          },
          "timeout": 15000
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "s04-n09",
      "name": "Enviar Messenger",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        2480,
        720
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/__SET_META_GRAPH_VERSION__/me/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer __SET_META_ACCESS_TOKEN__"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ recipient: { id: $json.chat_id }, message: { text: $json.mensaje } }) }}",
        "options": {}
      },
      "onError": "continueRegularOutput"
    },
