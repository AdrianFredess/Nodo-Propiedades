# =====================================================
# NODO PROPIEDADES — Variables de entorno
# Copiar este archivo como .env y completar los valores
# NUNCA subir .env a git
# =====================================================

# --- n8n ---
N8N_HOST=tu-dominio.com
N8N_PROTOCOL=https
WEBHOOK_URL=https://tu-dominio.com/
# Generar con: openssl rand -hex 16
N8N_ENCRYPTION_KEY=genera-una-clave-aleatoria-de-32-chars
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=cambia-esta-password-segura
# Settings > n8n API en la UI. Usada por WF-14 para health check de workflows activos.
N8N_API_KEY=genera-en-settings-api-de-n8n

# Token opcional de los webhooks del panel (X-Panel-Token). Vacío = auth off.
# Si lo seteás: docker compose up -d + VITE_PANEL_API_TOKEN en front/.env
PANEL_API_TOKEN=

# Opcional: prefijo para reconocer senders de Instagram (PSID) en lógica custom / logs.
META_INSTAGRAM_PSID_PREFIX=

# --- Meta WhatsApp Cloud API (bloqueado en muchas cuentas; alternativa: Evolution) ---
META_GRAPH_VERSION=v23.0
META_PHONE_NUMBER_ID=tu-phone-number-id
META_ACCESS_TOKEN=tu-access-token-permanente
META_VERIFY_TOKEN=tu-verify-token-personalizado
META_APP_SECRET=tu-app-secret
META_PAGE_ID=tu-page-id-de-facebook

# --- Evolution API (alternativa Baileys; opcional) ---
# docker compose -f docker-compose.evolution.yml --env-file .env.evolution up -d
EVOLUTION_API_KEY=cambia-esta-api-key
EVOLUTION_SERVER_URL=http://localhost:8080
EVOLUTION_INSTANCE_NAME=nodo-propiedades
EVOLUTION_WEBHOOK_URL=http://host.docker.internal:5678/webhook/evolution-whatsapp

# --- WAHA (WhatsApp WebJS local; alternativa a Meta Cloud) ---
# docker compose -f docker-compose.waha.yml --env-file .env.waha up -d
# Copiá de .env.waha.example → .env.waha (no commitear .env.waha)
WAHA_API_KEY=cambia-esta-api-key
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=cambia-esta-password
# Webhook en n8n: path evolution-whatsapp (SIMPLE-02)

# --- Telegram ---
# NUNCA pegar el token real en workflows del repo. Usá __SET_TELEGRAM_BOT_TOKEN__ o credencial n8n.
TELEGRAM_BOT_TOKEN=tu-token-del-bot

# --- Asesor ---
ADVISOR_PHONE=+549XXXXXXXXXX

# URL pública del catálogo (links en bot Telegram/WhatsApp). Default local: http://localhost:5173
# Con ngrok en :5173: https://TU-DOMINIO-CATALOGO.ngrok-free.dev
CATALOG_PUBLIC_BASE_URL=
# Secreto para tokens de ficha privada (mismo valor en prod y al regenerar media)
CATALOG_SHARE_SECRET=
# Segundo dominio ngrok reservado para el panel (opcional; ver scripts/ngrok-catalogo.bat)
NGROK_CATALOG_DOMAIN=

# --- Groq (reemplaza Ollama en producción cloud) ---
# Obtener gratis en: https://console.groq.com
GROQ_API_KEY=tu-api-key-de-groq

# --- Google Sheets ---
# El ID se actualiza con: node scripts/_actualizar_sheet_id.js ID
GOOGLE_SHEET_ID=1-0IBpaUl3svRmzMqNK0NYZYbuUDxCytnBd5Ql2DcOjo
# Planilla solo conversaciones / historial del bot (ej. titulo "conversaciones") — NO el catálogo
GOOGLE_SHEET_CONVERSACIONES_ID=
# Planilla nueva solo propiedades (stock). Mismo ID que en n8n (Leer Stock / Import).
# Cargar 30 filas de demo: npm run import-stock  (requiere config/google-credentials.json + token válido)
GOOGLE_SHEET_PROPIEDADES_ID=
NODO_PROPIEDADES_SHEET_ID=
