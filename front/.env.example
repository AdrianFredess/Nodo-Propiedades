# Panel comercial — Nodo Propiedades
# false = datos reales desde n8n/Sheets (recomendado si PANEL-01 está activo)
VITE_USE_MOCK=false
VITE_LEADS_API_URL=http://localhost:5678/webhook/panel-leads
VITE_ENVIO_MASIVO_URL=http://localhost:5678/webhook/envio-masivo
VITE_STOCK_UPDATE_URL=http://localhost:5678/webhook/panel-stock-update
VITE_LEAD_ACTIONS_URL=http://localhost:5678/webhook/panel-lead-actions
# Mismo valor que PANEL_API_TOKEN en .env raíz (vacío = auth off)
VITE_PANEL_API_TOKEN=
VITE_WS_URL=ws://127.0.0.1:3099/ws
# Polling fallback (si WS cae). Con WS abierto usa VITE_POLL_INTERVAL_WS_MS.
VITE_POLL_INTERVAL_MS=45000
VITE_POLL_INTERVAL_WS_MS=120000
# Asistente de voz: off | edge | browser | elevenlabs
# edge = voz argentina real (Tomás, vía ws-bridge) — recomendado
VITE_TTS_MODE=edge
VITE_TTS_URL=http://127.0.0.1:3099/tts
# Voz clonada (ElevenLabs) — ver docs/ASISTENTE-VOZ.md
VITE_ELEVENLABS_API_KEY=
VITE_ELEVENLABS_VOICE_ID=
# Humanizar respuestas con Groq (PANEL-06)
VITE_ASSISTANT_API_URL=http://localhost:5678/webhook/panel-assistant
VITE_ASSISTANT_HUMANIZE=true
# Forzar voz masculina argentina en Windows/Edge: pablo (default)
VITE_TTS_VOICE_HINT=pablo
